{
  "name": "dsh-remote-ssh",
  "version": "1.0.3",
  "description": "Remote SSH execution provider for DeepSeek Harness using native DSH tools",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "scripts",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "ARCHITECTURE.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "node ./scripts/build-host.mjs",
    "test": "node --test",
    "check": "node ./scripts/build-host.mjs && node --check src/index.js && node --check src/utils.js && node --check src/store.js && node --check src/connection-manager.js && node --check src/remote-fs.js && node --check src/remote-subprocess.js && node --check src/remote-realm.js && node --check dist/index.js && node --check client.js && node --test"
  },
  "dependencies": {
    "@deepseek-ai/dsh-bash-local": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-tool-terminal": "^0.1.0-rc.8",
    "@vscode/ripgrep-universal": "1.18.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "ssh2": "1.17.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-client-connection": "*",
    "@deepseek-ai/dsh-client-runtime": "*",
    "@deepseek-ai/dsh-client-ui-conversation": "*",
    "@deepseek-ai/dsh-client-ui-primitives": "*",
    "@deepseek-ai/dsh-client-ui-slots": "*",
    "@deepseek-ai/dsh-fs": "*",
    "@deepseek-ai/dsh-fs-observation-policy": "*",
    "@deepseek-ai/dsh-jobs": "*",
    "@deepseek-ai/dsh-shell": "*",
    "@deepseek-ai/dsh-shell-env": "*",
    "@deepseek-ai/dsh-subprocess": "*",
    "@deepseek-ai/dsh-system-prompt": "*",
    "@deepseek-ai/dsh-terminal": "*",
    "@deepseek-ai/dsh-terminal-bash": "*",
    "@deepseek-ai/dsh-tool-bash": "*",
    "@deepseek-ai/dsh-tool-fs": "*",
    "@deepseek-ai/dsh-tool-fs-search": "*",
    "react": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "ssh",
    "sftp",
    "remote-execution",
    "remote-development",
    "plugin"
  ],
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-runtime": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-conversation": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "@deepseek-ai/dsh-fs": {
      "optional": true
    },
    "@deepseek-ai/dsh-subprocess": {
      "optional": true
    },
    "@deepseek-ai/dsh-fs-observation-policy": {
      "optional": true
    },
    "@deepseek-ai/dsh-tool-fs": {
      "optional": true
    },
    "@deepseek-ai/dsh-tool-fs-search": {
      "optional": true
    },
    "@deepseek-ai/dsh-tool-bash": {
      "optional": true
    },
    "@deepseek-ai/dsh-terminal": {
      "optional": true
    },
    "@deepseek-ai/dsh-terminal-bash": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/dsh-shell": {
      "optional": true
    },
    "@deepseek-ai/dsh-shell-env": {
      "optional": true
    },
    "@deepseek-ai/dsh-jobs": {
      "optional": true
    }
  },
  "homepage": "https://github.com/NaNQiQ/deepseek-harness-remote-ssh#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NaNQiQ/deepseek-harness-remote-ssh.git"
  },
  "bugs": {
    "url": "https://github.com/NaNQiQ/deepseek-harness-remote-ssh/issues"
  }
}
